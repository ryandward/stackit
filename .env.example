PG_HOST=localhost
PG_PORT=54322
PG_DATABASE=stackit
PG_USER=stackit
PG_PASSWORD=stackit
PORT=3000

# Invite-token gate. Required header on every API call when set.
# Leave empty to disable the gate (local dev).
INVITE_TOKEN=

# CORS origins, comma-separated. Empty allows any origin (dev convenience).
# Production: set to the SPA host, e.g. https://app.stackit.bio
CORS_ORIGIN=
